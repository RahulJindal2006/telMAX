---
/**
 * A photograph, cropped, resized and re-encoded at build time (AVIF,
 * then WebP, then JPEG) so no visitor downloads more than their screen
 * can show.
 *
 * Props
 *   src       an imported image from src/assets/photos
 *   alt       what the picture shows ("" when it only decorates)
 *   ratio     width over height of the frame, e.g. 4 / 5. The picture is
 *             cropped to it here, not stretched in the browser.
 *   focus     which part survives the crop: "centre", "top", "right", ...
 *   sizes     how wide the picture is laid out, as a `sizes` attribute
 *   eager     true for a picture at the top of a page
 */
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  ratio?: number;
  focus?: string;
  sizes?: string;
  eager?: boolean;
  class?: string;
}
const {
  src,
  alt,
  ratio = src.width / src.height,
  focus = "centre",
  sizes = "(max-width: 900px) 100vw, 560px",
  eager = false,
  class: extra,
} = Astro.props;

/* The largest crop of this shape the original can give. */
const fullW = Math.round(Math.min(src.width, src.height * ratio));
const fullH = Math.round(fullW / ratio);
const widths = [420, 640, 960, 1280].filter((w) => w < fullW);
widths.push(Math.min(fullW, 1600));
---

<Picture
  src={src}
  alt={alt}
  width={fullW}
  height={fullH}
  fit="cover"
  position={focus}
  formats={["avif", "webp"]}
  fallbackFormat="jpg"
  widths={widths}
  sizes={sizes}
  class:list={["photo", extra]}
  loading={eager ? "eager" : "lazy"}
  fetchpriority={eager ? "high" : undefined}
  decoding={eager ? "sync" : "async"}
  style={`aspect-ratio:${fullW}/${fullH}`}
/>
